APP_NAME=立洋校园社区
# dev / prod。ENV=prod 时启动会强校验 JWT_SECRET，且 Cookie 自动加 Secure 标记
ENV=dev
# 生产环境改为 mysql+pymysql://user:password@host:3306/ly_community
DATABASE_URL=sqlite:///./ly_community.sqlite3
REDIS_URL=redis://localhost:6379/0
# 生产环境必须替换为 >=32 位强随机字符串（ENV=prod 时默认值会拒绝启动）
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
# 生产环境改为正式域名，如 https://your.domain.com
FRONTEND_ORIGIN=http://localhost:5173
# 额外允许的来源，多个用逗号分隔（内网穿透/测试域名用，生产建议留空）
EXTRA_ORIGINS=
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ly-community
# 私密图片桶（学生证等敏感照片，默认私有策略，禁止公开读）
MINIO_PRIVATE_BUCKET=ly-community-private
AI_PROVIDER=OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=30
# 启动时自动生成的种子邀请码数量（冷启动用，管理员线下分发）
SEED_INVITE_CODE_COUNT=10
# 管理员微信号（前端弹窗展示，用于学生获取种子邀请码）
ADMIN_WECHAT=

# ==================== 数据库备份（备份到 GitHub 私有仓库） ====================
# 本地备份目录（相对 backend 目录）
BACKUP_DIR=backups
# 保留最近多少个备份（GitHub 和本地都会自动清理更旧的）
BACKUP_KEEP=30
# GitHub 备份仓库（私有）
BACKUP_GITHUB_REPO=Qiu-He-123/liyang-backups
# GitHub 令牌：GitHub -> Settings -> Developer settings -> Personal access tokens
# （classic，勾选 repo 权限即可）。不要提交到代码仓库，.env 已被 gitignore。
GITHUB_TOKEN=
# 强烈建议设置：备份文件会用 openssl AES-256 加密（Linux 自带 openssl）
# BACKUP_PASSPHRASE=
# MySQL 跑在 Docker 里时，自定义 dump 命令模板：
#   {db} 会被替换为库名，{password} 被替换为下面的 BACKUP_MYSQL_PASSWORD
# 示例（路径按服务器实际情况改）：
# BACKUP_MYSQL_CMD=docker compose -f /opt/liyang/deploy/docker-compose.yml exec -T mysql mysqldump -uroot -p"{password}" --single-transaction --routines --triggers {db}
# 恢复时对应的 mysql 命令（{file} 会被替换为备份文件路径）：
# BACKUP_MYSQL_RESTORE_CMD=docker compose -f /opt/liyang/deploy/docker-compose.yml exec -T mysql mysql -uroot -p"{password}" {db} < {file}
# BACKUP_MYSQL_PASSWORD=
