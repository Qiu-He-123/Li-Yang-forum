# ============ 立洋社区 · 生产部署环境变量模板 ============
# 复制为 deploy/.env 并填上强密码，严禁使用默认值（ENV=prod 时后端启动会强校验拒绝默认口令）

# MySQL root 密码：>=16 位随机串，禁止使用 lycommunity
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_PASSWORD_1
MYSQL_DATABASE=ly_community

# MinIO 密钥：>=16 位随机串，禁止使用 minioadmin
MINIO_ACCESS_KEY=REPLACE_WITH_STRONG_MINIO_ACCESS
MINIO_SECRET_KEY=REPLACE_WITH_STRONG_MINIO_SECRET
MINIO_BUCKET=ly-community
MINIO_PRIVATE_BUCKET=ly-community-private

# 应用环境：prod 强制开启安全校验（JWT/DB/MinIO 默认值全部拒绝启动）
APP_ENV=prod
