    "styleContinuityAnchors": {
      "colorSystem": "Apple System Blue #007AFF as sole accent (concentrated in CTAs/active states); neutral frame of near-black #1d1d1f text, silver mist #f5f5f7/#f2f2f7 backgrounds, white cards. No multi-hue palettes, no loud gradients except one optional frosted hero.",
      "shapeSystem": "Global radius 1.2rem on cards/media; buttons fully pill (rounded-full); inputs rounded; 1px borders structural not decorative; whisper-light shadows at rest, deeper only on hover/overlay.",
      "typographySystem": "DM Sans for all UI/editorial; JetBrains Mono only for numeric/stats. Titles 600 weight with slight negative tracking; body 14-16px/400/1.55; no emoji; editorial calm voice.",
      "spacingSystem": "0.24rem base; scale 4/8/12/16/24/32/48/64; whitespace carries hierarchy over divider lines; 12-col web grid.",
      "componentLanguage": "Quiet border+spacing-led cards (not decoration); pill capsule buttons; Apple-store-like minimal top nav; photography-first masonry cards deferential to content.",
      "surfaceAndDepth": "Border-first, shadow-second; cards rest on 0 1px 2px rgba(0,0,0,0.04); hover lifts to 0 8px 24px -8px rgba(0,0,0,0.08); overlays up to 0 24px 64px -12px rgba(0,0,0,0.12).",
      "imageryAndIconography": "Natural-light campus photography, no text in images, no mixed warm/cool on one card; SF-style line icons via library assets/icons.",
      "interactionTone": "Subtle 150-250ms transitions on cubic-bezier(0.32,0.72,0,1); hover lifts softly; no flashy motion."
    }
